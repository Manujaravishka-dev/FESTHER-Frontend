# Public environment variables.
# Copy to .env and add the real values. Never commit real secrets.

# Base URL of the FESTHER backend API (leave empty to run in demo/store mode).
NEXT_PUBLIC_API_URL=

# Dine-in / delivery WhatsApp number used for restaurant orders
# (international format, digits only — e.g. 94771234567).
NEXT_PUBLIC_RESTAURANT_WHATSAPP=

# URL of the deployed public site (used in WhatsApp messages). Optional.
NEXT_PUBLIC_SITE_URL=

# ---------- Backend-only PayHere configuration ----------
# These are used by the FESTHER backend (festher_backend), never by this
# frontend. The frontend only redirects the guest to the PayHere Checkout
# page; every payment must be verified on the server via PAYHERE_NOTIFY_URL.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=1
# PAYHERE_RETURN_URL=https://your-domain.com/order/payment/return
# PAYHERE_CANCEL_URL=https://your-domain.com/order/payment/cancel
# PAYHERE_NOTIFY_URL=https://your-backend.com/api/payments/payhere/notify